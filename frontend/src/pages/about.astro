---
import GroupLayout from "../layouts/GroupLayout.astro";
import Advisor from "../components/Advisor.astro";
import GroupHonors from "../components/GroupHonors.astro";
---

<GroupLayout title="关于我们">
  <section class="group-section people-surface profile-spread" id="advisor">
    <header class="profile-heading">
      <p class="group-kicker" lang="en">Principal investigator</p>
      <h1>导师与课题组</h1>
      <p>以模式识别与机器学习为方法基础，连接复杂系统故障诊断、时序预测、脑机接口与工程实践。</p>
      <a href="#honors">学术荣誉 ↓</a>
    </header>
    <Advisor />
  </section>
  <section class="group-section" id="honors">
    <h2>学术荣誉</h2>
    <GroupHonors />
  </section>
</GroupLayout>
