---
import GroupLayout from "../layouts/GroupLayout.astro";
import Advisor from "../components/Advisor.astro";
import GroupMembers from "../components/GroupMembers.astro";
import { labTeam } from "../data/group";
---

<GroupLayout title="团队成员">
  <header class="group-header">
    <p class="group-kicker">PEOPLE</p>
    <h1>团队成员</h1>
    <p>课题组成员与脑机实验室协作团队，共同连接学术研究与工程实践。</p>
  </header>
  <section class="group-section">
    <Advisor />
  </section>
  <section class="group-section">
    <h2>课题组成员</h2>
    <GroupMembers />
  </section>
  <section class="group-section" id="lab-team">
    <h2>脑机实验室协作团队</h2>
    <p>
      以下保留实验室网站中的协作身份；临床伙伴和学术顾问不归类为课题组学生。
    </p>
    <div class="group-grid group-subsection">
      {labTeam.coreTeam.slice(1).map((m) => (
        <article class="group-card">
          <img
            src={m.img}
            alt={m.name}
            width="90"
            height="110"
            loading="lazy"
          />
          <h3>
            {m.name} · {m.role}
          </h3>
          <p>
            {m.title} · {m.affil}
          </p>
          <p>{m.bio}</p>
        </article>
      ))}
    </div>
    <h3 class="group-subsection">学术顾问</h3>
    <div class="group-grid">
      {labTeam.advisors.map((m) => (
        <article class="group-card">
          <h3>{m.name}</h3>
          <p>
            {m.title} · {m.affil}
          </p>
          <p>{m.desc}</p>
        </article>
      ))}
    </div>
    <h3 class="group-subsection">实验室本科成员与校友</h3>
    <div class="group-grid group-people">
      {labTeam.undergrads.map((m) => (
        <article class="group-card">
          <img
            src={m.img}
            alt={m.name}
            width="90"
            height="110"
            loading="lazy"
          />
          <h3>{m.name}</h3>
          <p>{m.badge}</p>
          <p>{m.focuses.join(" · ")}</p>
        </article>
      ))}
    </div>
  </section>
</GroupLayout>
