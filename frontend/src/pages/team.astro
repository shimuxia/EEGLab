---
import SectionHeader from "../components/SectionHeader.astro";
import GroupLayout from "../layouts/GroupLayout.astro";
import GroupMembers from "../components/GroupMembers.astro";
import { advisor, labTeam } from "../data/group";
---

<GroupLayout title="团队成员">
  <SectionHeader title="团队成员" english="PEOPLE" links={[{"href": "#advisor", "label": "导师"}, {"href": "#members", "label": "课题组成员"}, {"href": "#lab-team", "label": "实验室协作团队"}]}>
    课题组成员与脑机实验室协作团队，共同连接学术研究与工程实践。
  </SectionHeader>
  <section class="group-section people-surface" id="advisor">
    <div class="team-lead">
      <img src={advisor.photo} alt="严颖老师肖像" width="140" height="172" />
      <div>
        <p class="group-kicker">课题组导师</p>
        <h2>{advisor.name} <small lang="en">{advisor.nameEn}</small></h2>
        <p>{advisor.affiliation} · {advisor.role}</p>
        <a href="/about#advisor">导师介绍与学术经历</a>
      </div>
    </div>
  </section>
  <section class="group-section people-surface" id="members">
    <h2>课题组成员</h2>
    <GroupMembers />
  </section>
  <section class="group-section people-surface" id="lab-team">
    <h2>脑机实验室协作团队</h2>
    <p>
      金牛湖脑机实验室的研究与临床伙伴、学术顾问及学生成员。
    </p>
    <div class="group-grid group-subsection">
      {labTeam.coreTeam.slice(1).map((m) => (
        <article class="group-card">
          <img
            src={m.img}
            alt={m.name}
            width="90"
            height="110"
            loading="lazy"
          />
          <h3>
            {m.name} · {m.role}
          </h3>
          <p>
            {m.title} · {m.affil}
          </p>
          <p>{m.bio}</p>
        </article>
      ))}
    </div>
    <h3 class="group-subsection">学术顾问</h3>
    <div class="group-grid">
      {labTeam.advisors.map((m) => (
        <article class="group-card lab-advisor-card">
          <img
            src={m.img}
            alt={m.name}
            width="90"
            height="110"
            loading="lazy"
          />
          <h3>{m.name}</h3>
          <p>
            {m.title} · {m.affil}
          </p>
          <p>{m.desc}</p>
        </article>
      ))}
    </div>
    <h3 class="group-subsection">实验室本科成员与校友</h3>
    <div class="group-grid group-people">
      {labTeam.undergrads.map((m) => (
        <article class="group-card">
          <img
            src={m.img}
            alt={m.name}
            width="90"
            height="110"
            loading="lazy"
          />
          <h3>{m.name}</h3>
          <p>{m.badge}</p>
          <p>{m.focuses.join(" · ")}</p>
        </article>
      ))}
    </div>
  </section>
</GroupLayout>
