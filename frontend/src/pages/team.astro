---
import SectionHeader from "../components/SectionHeader.astro";
import GroupLayout from "../layouts/GroupLayout.astro";
import GroupMembers from "../components/GroupMembers.astro";
import { advisor, labTeam } from "../data/group";
import content from "../data/group-content.json";
---

<GroupLayout title="团队成员">
  <SectionHeader
    title="团队成员"
    english="People"
    links={[{ href: "#advisor", label: "导师" }, { href: "#members", label: "课题组成员" }, { href: "#lab-team", label: "实验室协作团队" }]}
  >
    课题组成员与脑机实验室协作团队，共同连接学术研究与工程实践。
  </SectionHeader>

  <section class="group-section people-surface" id="advisor" aria-labelledby="advisor-name">
    <div class="wrap team-lead">
      <span class="portrait">
        <img src={advisor.photo} alt="严颖老师肖像" width="248" height="298" />
      </span>
      <div>
        <p class="kicker">课题组导师</p>
        <h2 id="advisor-name">{advisor.name} <span class="en" lang="en">{advisor.nameEn}</span></h2>
        <p>{advisor.affiliation} · {advisor.role}</p>
        <p>{content.team.advisor.note}</p>
        <p class="team-lead-bio">{advisor.biography}</p>
        <a class="link" href="/about#advisor">导师介绍与学术经历 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="group-section people-surface" id="members" aria-labelledby="members-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="members-title">课题组成员</h2>
      </header>
      <GroupMembers />
    </div>
  </section>

  <section class="group-section people-surface" id="lab-team" aria-labelledby="lab-team-title">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="kicker">金牛湖脑机实验室</p>
          <h2 id="lab-team-title">脑机实验室协作团队</h2>
        </div>
        <p class="section-note">金牛湖脑机实验室的研究与临床伙伴、学术顾问及学生成员。</p>
      </header>

      <div class="lab-core">
        {labTeam.coreTeam.slice(1).map((m) => (
          <article class="core-card">
            <span class="portrait">
              <img src={m.img} alt={m.name} width="240" height="300" loading="lazy" />
            </span>
            <div>
              <p class="kicker">{m.role}</p>
              <h3>{m.name}</h3>
              <p class="core-meta">{m.title} · {m.affil}</p>
              <p>{m.bio}</p>
              <ul class="tag-list" aria-label="工作内容">{m.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>

      <h3 class="group-subsection sub-title">学术顾问 <span class="tnum">{labTeam.advisors.length}</span></h3>
      <ul class="people-grid people-grid-lg">
        {labTeam.advisors.map((m) => (
          <li class="person lab-advisor-card">
            <span class="portrait">
              <img src={m.img} alt={m.name} width="180" height="225" loading="lazy" />
            </span>
            <h4>{m.name}</h4>
            <p>{m.title} · {m.affil}</p>
            <p>{m.desc}</p>
          </li>
        ))}
      </ul>

      <h3 class="group-subsection sub-title">实验室本科成员与校友 <span class="tnum">{labTeam.undergrads.length}</span></h3>
      <ul class="people-grid">
        {labTeam.undergrads.map((m) => (
          <li class="person">
            <span class="portrait">
              <img src={m.img} alt={m.name} width="180" height="225" loading="lazy" />
            </span>
            <h4>{m.name}</h4>
            <p>{m.badge}</p>
            <p>{m.focuses.join(" · ")}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</GroupLayout>
