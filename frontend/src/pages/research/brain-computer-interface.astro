---
import SectionHeader from "../../components/SectionHeader.astro";
import GroupLayout from "../../layouts/GroupLayout.astro";
import { research } from "../../data/research";
import { labSlogan, labFigures } from "../../data/source-extras";
import PublicationCount from "../../components/PublicationCount";
---

<GroupLayout title="脑机接口 · 金牛湖脑机实验室">
  <SectionHeader
    title="脑机接口"
    english="Brain-Computer Interface · Jinniu Lake BCI Lab"
    kicker="研究方向 02 · 金牛湖脑机实验室"
    links={[{ href: "#lab-film", label: "实验影像" }, { href: "#lab-topics", label: "五个研究专题" }]}
  >
    金牛湖脑机实验室是严颖课题组的脑机接口研究与实验平台，连接脑电信号分析、运动意图解码与智能控制。
  </SectionHeader>

  <section class="lab-statement" aria-label="实验室理念">
    <div class="wrap lab-statement-grid">
      <p class="lab-statement-line"><strong>{labSlogan.line.split("，")[0]}，<br />{labSlogan.line.split("，")[1]}</strong><span lang="en">{labSlogan.en}</span></p>
      <dl class="figures">
        <div>
          <dt>期刊论文</dt>
          <dd class="tnum"><PublicationCount type="journal" client:load /></dd>
        </div>
        {labFigures.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class="tnum"><span data-count={f.value}>{f.value}</span>{f.suffix}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="lab-film" id="lab-film" aria-labelledby="lab-film-title">
    <div class="wrap">
      <div class="lab-film-head">
        <h2 id="lab-film-title">实验影像</h2>
        <p>脑电采集设备、气动手套与控制器的研究展示。</p>
      </div>
      <video
        class="group-video"
        controls
        muted
        playsinline
        preload="metadata"
        poster="/videos/promo-hero-poster-v1.webp"
        aria-label="脑机实验室研究展示"
      >
        <source src="/videos/promo-hero-v1.mp4" type="video/mp4" />
        您的浏览器不支持视频播放。
      </video>
    </div>
  </section>

  <section class="group-section" id="lab-topics" aria-labelledby="topics-title">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="kicker">研究专题 <span class="num">05</span></p>
          <h2 id="topics-title">研究专题</h2>
          <p class="section-desc">{labSlogan.researchIntro}</p>
        </div>
      </header>
      <ol class="topic-stories">
        {research.map((r, i) => (
          <li class:list={["topic-story", { flip: i % 2 === 1 }]} data-reveal>
            <a class="topic-story-img" href={`/research/${r.slug}`} tabindex="-1" aria-hidden="true">
              <img src={`/images/research/${r.slug}-diagram.webp`} alt="" loading="lazy" width="620" height="420" />
            </a>
            <div class="topic-story-copy">
              <span class="tnum topic-no">{r.num} / 05</span>
              <h3>{r.title}<span class="en" lang="en">{r.titleEn}</span></h3>
              <p class="topic-sub">{r.subtitle}</p>
              <p>{r.overview}</p>
              <ol class="method-titles" aria-label="研究方法">
                {r.methods.map((m, j) => <li><span class="tnum">{String(j + 1).padStart(2, "0")}</span>{m.title}</li>)}
              </ol>
              <ul class="tag-list" aria-label="关键词">{r.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="link" href={`/research/${r.slug}`}>研究方法与相关论文 <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ol>
      <div class="page-actions">
        <a class="btn btn-ghost" href="/achievements">实验成果与影像 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/team#lab-team">实验室协作团队 <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</GroupLayout>
