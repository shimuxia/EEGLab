---
import SectionHeader from "../../components/SectionHeader.astro";
import GroupLayout from "../../layouts/GroupLayout.astro";
import { research } from "../../data/research";
---

<GroupLayout title="脑机接口 · 金牛湖脑机实验室">
  <SectionHeader title="脑机接口" english="RESEARCH / BRAIN-COMPUTER INTERFACE" links={[{"href": "#lab-film", "label": "实验影像"}, {"href": "#lab-topics", "label": "五个研究专题"}]}>
    金牛湖脑机实验室是严颖课题组的脑机接口研究与实验平台，连接脑电信号分析、运动意图解码与智能控制。
  </SectionHeader>
  <section class="group-section" id="lab-film">
    <h2>实验影像</h2>
    <video
      class="group-video"
      controls
      muted
      playsinline
      preload="metadata"
      poster="/videos/promo-hero-poster-v1.webp"
      aria-label="脑机实验室研究展示"
    >
      <source src="/videos/promo-hero-v1.mp4" type="video/mp4" />
      您的浏览器不支持视频播放。
    </video>
  </section>
  <section class="group-section" id="lab-topics">
    <h2>研究专题</h2>
    <div class="group-grid">
      {research.map((r) => (
        <article class="group-card">
          <img class="topic-photo" src={`/images/research/${r.slug}.webp`} alt={r.title} loading="lazy" width="600" height="360" />
          <h3>{r.title}</h3>
          <p>{r.overview}</p>
          <a href={`/research/${r.slug}`}>研究方法与相关论文 →</a>
        </article>
      ))}
    </div>
    <div class="group-actions">
      <a href="/achievements">实验成果与影像 →</a>
      <a href="/team#lab-team">实验室协作团队 →</a>
    </div>
  </section>
</GroupLayout>
