---
import SectionHeader from "../../components/SectionHeader.astro";
import GroupLayout from "../../layouts/GroupLayout.astro";
import GroupResearch from "../../components/GroupResearch.astro";
import { directions } from "../../data/group";
import { research } from "../../data/research";
import { researchIntro } from "../../data/source-extras";
---

<GroupLayout title="研究方向">
  <SectionHeader title="研究方向" english="Research" links={[{ href: "#fields", label: "七个研究方向" }, { href: "#lab-topics", label: "脑机实验室专题" }]}>
    {researchIntro.desc}
  </SectionHeader>
  <section class="group-section" id="fields" aria-labelledby="fields-title">
    <h2 class="sr-only" id="fields-title">{researchIntro.title}</h2>
    <div class="wrap field-atlas">
      <nav class="atlas-list" aria-label="研究章节">
        {directions.map((d) => (
          <a href={`#${d.id}`}><small class="tnum">{d.no}</small>{d.title}</a>
        ))}
      </nav>
      <div>
        <GroupResearch />
        <p class="research-note">{researchIntro.note}</p>
      </div>
    </div>
  </section>
  <section class="group-section surface" id="lab-topics" aria-labelledby="lab-topics-title">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="kicker">金牛湖脑机实验室</p>
          <h2 id="lab-topics-title">脑机实验室研究专题</h2>
        </div>
        <a class="link" href="/research/brain-computer-interface">实验室总览 <span class="arrow" aria-hidden="true">↗</span></a>
      </header>
      <ol class="topic-grid">
        {research.map((r, i) => (
          <li style={`--i:${i}`} data-reveal>
            <a class="topic-card" href={`/research/${r.slug}`}>
              <span class="topic-img">
                <img src={`/images/research/${r.slug}-diagram.webp`} alt={`${r.title}实验装置示意`} loading="lazy" width="620" height="420" />
              </span>
              <span class="topic-copy">
                <span class="tnum topic-no">{r.num}</span>
                <h3>{r.title}</h3>
                <p class="topic-sub">{r.subtitle}</p>
                <p>{r.desc}</p>
                <span class="topic-more">研究详情 <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</GroupLayout>

<script>
  const list = document.querySelector(".atlas-list");
  if (list && "IntersectionObserver" in window) {
    const links = [...list.querySelectorAll("a")];
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          for (const link of links) {
            if (link.hash === "#" + entry.target.id) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          }
        }
      }
    }, { rootMargin: "-18% 0px -57% 0px" });
    document.querySelectorAll(".research-overview article").forEach(el => observer.observe(el));
  }
</script>
