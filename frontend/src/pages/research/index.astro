---
import GroupLayout from "../../layouts/GroupLayout.astro";
import GroupResearch from "../../components/GroupResearch.astro";
import { research } from "../../data/research";
---

<GroupLayout title="研究方向">
  <header class="group-header">
    <p class="group-kicker">RESEARCH</p>
    <h1>研究方向</h1>
    <p>从复杂系统诊断到脑机交互，以可解释方法、时序建模与优化连接真实场景。</p>
  </header>
  <section class="group-section">
    <GroupResearch />
  </section>
  <section class="group-section">
    <h2>脑机实验室研究专题</h2>
    <div class="group-grid">
      {research.map((r) => (
        <article class="group-card">
          <h3>{r.title}</h3>
          <p>{r.desc}</p>
          <a href={`/research/${r.slug}`}>研究详情 →</a>
        </article>
      ))}
    </div>
  </section>
</GroupLayout>
