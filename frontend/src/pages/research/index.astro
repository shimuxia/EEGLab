---
import SectionHeader from "../../components/SectionHeader.astro";
import GroupLayout from "../../layouts/GroupLayout.astro";
import GroupResearch from "../../components/GroupResearch.astro";
import { directions } from "../../data/group";
import { research } from "../../data/research";
---

<GroupLayout title="研究方向">
  <SectionHeader title="研究方向" english="RESEARCH" links={[{"href": "#fields", "label": "七个研究方向"}, {"href": "#lab-topics", "label": "脑机实验室专题"}]}>
    从复杂系统诊断到脑机交互，以可解释方法、时序建模与优化连接真实场景。
  </SectionHeader>
  <section class="group-section" id="fields">
    <div class="field-atlas">
      <nav class="atlas-list" aria-label="研究章节">
        {directions.map(d => <a href={`#${d.id}`}><small>{d.no}</small>{d.title}</a>)}
      </nav>
      <GroupResearch />
    </div>
  </section>
  <section class="group-section" id="lab-topics">
    <h2>脑机实验室研究专题</h2>
    <div class="group-grid">
      {research.map((r) => (
        <article class="group-card">
          <img class="topic-photo" src={`/images/research/${r.slug}.webp`} alt={r.title} loading="lazy" width="600" height="360" />
          <h3>{r.title}</h3>
          <p>{r.desc}</p>
          <a href={`/research/${r.slug}`}>研究详情 →</a>
        </article>
      ))}
    </div>
  </section>
</GroupLayout>

<script>
  const list = document.querySelector(".atlas-list");
  if (list && "IntersectionObserver" in window) {
    const links = [...list.querySelectorAll("a")];
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          for (const link of links) {
            if (link.hash === "#" + entry.target.id) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          }
        }
      }
    }, { rootMargin: "-18% 0px -57% 0px" });
    document.querySelectorAll(".research-overview article").forEach(el => observer.observe(el));
  }
</script>
