---
import DevicePlate from "../../components/DevicePlate.astro";
import GroupLayout from "../../layouts/GroupLayout.astro";
import RelatedPublications from "../../components/RelatedPublications";
import { research } from "../../data/research";

export function getStaticPaths() {
  return research.map((r) => ({ params: { slug: r.slug }, props: { item: r } }));
}

const { item } = Astro.props;
const currentIdx = research.findIndex((r) => r.slug === item.slug);
const prev = research[currentIdx - 1];
const next = research[currentIdx + 1];
---

<GroupLayout title={`${item.title} · 脑机实验室`} description={item.desc}>
  <header class="detail-intro">
    <div class="wrap detail-grid">
      <div class="detail-copy">
        <nav class="crumbs" aria-label="位置">
          <a href="/research">研究方向</a>
          <span aria-hidden="true">/</span>
          <a href="/research/brain-computer-interface">脑机接口</a>
        </nav>
        <p class="kicker">脑机实验室专题 <span class="num">{item.num} / 05</span></p>
        <h1 class="page-title">{item.title}<span class="en" lang="en">{item.titleEn}</span></h1>
        <p class="page-lead">{item.desc}</p>
      </div>
      <DevicePlate slug={item.slug} title={item.title} />
    </div>
  </header>

  <div class="wrap page-wrap">
    <aside class="sidebar">
      <nav class="dir-nav" aria-label="脑机实验室专题">
        <p class="dir-nav-label">五个专题</p>
        {research.map((r) => (
          <a
            href={`/research/${r.slug}`}
            class:list={["dir-nav-item", { active: r.slug === item.slug }]}
            aria-current={r.slug === item.slug ? "page" : undefined}
          >
            <span class="dir-num tnum">{r.num}</span>
            {r.title}
          </a>
        ))}
      </nav>
    </aside>

    <div class="detail-main">
      <section class="overview" aria-labelledby="overview-title">
        <h2 class="sec-title" id="overview-title">研究概述</h2>
        <p class="sec-body">{item.overview}</p>
      </section>

      <section class="methods" aria-labelledby="methods-title">
        <h2 class="sec-title" id="methods-title">研究方法</h2>
        <ol class="method-list">
          {item.methods.map((m, i) => (
            <li class="method-item" data-reveal style={`--i:${i}`}>
              <span class="method-num tnum">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="method-title">{m.title}</h3>
              <p class="method-desc">{m.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <ul class="tag-list detail-tags" aria-label="关键词">
        {item.tags.map((t) => <li>{t}</li>)}
      </ul>

      <RelatedPublications tags={item.tags} limit={3} variant="detail" client:load />

      <nav class="pager" aria-label="上一个与下一个专题">
        {prev ? (
          <a href={`/research/${prev.slug}`} class="pager-item prev">
            <span class="pager-label">← 上一个</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/research/${next.slug}`} class="pager-item next">
            <span class="pager-label">下一个 →</span>
            <span class="pager-title">{next.title}</span>
          </a>
        ) : <span />}
      </nav>
    </div>
  </div>
</GroupLayout>
