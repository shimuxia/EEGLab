---
import GroupLayout from "../layouts/GroupLayout.astro";
import SignalTrace from "../components/SignalTrace.astro";
---

<GroupLayout title="页面未找到">
  <header class="group-header page-mast not-found">
    <div class="wrap">
      <div>
        <p class="kicker">404 · 页面未找到</p>
        <h1>页面未找到<span class="en" lang="en">Page not found</span></h1>
        <p class="masthead-lead">这个地址可能已更改。你可以从研究方向继续浏览，或返回课题组首页。</p>
        <div class="page-actions">
          <a class="btn" href="/">返回首页</a>
          <a class="btn btn-ghost" href="/research">浏览研究方向</a>
        </div>
      </div>
      <div class="not-found-trace"><SignalTrace index={5} grid /></div>
    </div>
  </header>
</GroupLayout>
