---
import GroupLayout from "../layouts/GroupLayout.astro";
import HomeResearch from "../components/HomeResearch.astro";
import GroupHonors from "../components/GroupHonors.astro";
import ResearchGlyph from "../components/ResearchGlyph.astro";
import PublicationCount from "../components/PublicationCount";
import { advisor, directions, members, representativePapers } from "../data/group";
import { research } from "../data/research";
import { advisorQuote, labFigures, labSlogan, researchIntro, researchTaglines } from "../data/source-extras";
import galleryData from "../data/gallery.toml";

// Image wall uses 400px-tall derivatives in /images/achievements/wall/ (originals stay in the gallery).
const wallA = (galleryData as any).waterfall_a as { src: string }[];
const wallB = (galleryData as any).waterfall_b as { src: string }[];
---

<GroupLayout
  title="严颖课题组"
  description="南京信息工程大学严颖课题组：以模式识别与机器学习，探索复杂系统诊断、脑机接口与智能预测。"
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="wrap hero-grid">
      <div class="home-hero-copy">
        <p class="kicker hero-kicker">南京信息工程大学 · 自动化学院</p>
        <h1 id="home-title" class="hero-title">
          <span class="hero-line"><span>严颖</span></span><span class="hero-line"><span>课题组</span></span>
        </h1>
        <p class="hero-en" lang="en">Yan Ying Research Group</p>
        <p class="hero-lead">用机器学习读懂复杂系统与脑电信号，<br />让数据变成诊断和决策。</p>
        <div class="hero-actions">
          <a class="btn" href="#research">探索研究方向 <span class="arrow" aria-hidden="true">↓</span></a>
          <a class="btn btn-ghost" href="/join">了解招生</a>
        </div>
      </div>
      <a class="hero-pi" href="/about">
        <img src={advisor.photo} alt="严颖老师肖像" width="248" height="298" fetchpriority="high" />
        <span class="hero-pi-copy">
          <span class="hero-pi-label">课题组负责人</span>
          <strong>严颖 <span lang="en">Ying Yan</span></strong>
          <span>副教授 · 硕士生导师</span>
        </span>
      </a>
    </div>

    <nav class="hero-bottom" aria-label="研究方向索引" data-thread>
      <div class="wrap">
        <div class="thread-head">
          <h2>{researchIntro.title}</h2>
          <p lang="en">Seven directions, one thread</p>
        </div>
        <ol class="thread">
          {directions.map((r, i) => (
            <li style={`--i:${i}`}>
              <a class="thread-node" href={i === 1 ? "/research/brain-computer-interface" : `/research#${r.id}`}>
                <ResearchGlyph index={i} class="thread-glyph" />
                <span class="thread-dot" aria-hidden="true"></span>
                <span class="thread-text">
                  <span class="thread-no tnum">{r.no}</span>
                  <strong>{r.title}</strong>
                  <span class="thread-tagline">{researchTaglines[i]}</span>
                  {i === 1 && <span class="thread-tag">金牛湖脑机实验室</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  </section>

  <section class="home-intro" id="about" data-reveal>
    <div class="wrap intro-grid">
      <p class="kicker">研究理念</p>
      <h2 class="intro-statement">从复杂系统中<em>识别规律</em>，<br />把方法落到真实场景。</h2>
      <div class="intro-body">
        <p>我们立足模式识别与机器学习，在复杂系统诊断、脑电分析、时序预测和优化决策之间，寻找方法与应用的连接。</p>
        <a class="link" href="/about">了解严颖课题组 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="home-research band-mist" id="research" aria-labelledby="research-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <div>
          <p class="kicker">研究方向 <span class="num">07</span></p>
          <h2 id="research-title">七个研究方向</h2>
          <p class="section-desc">{researchIntro.desc}</p>
        </div>
        <a class="link" href="/research">全部研究方向 <span class="arrow" aria-hidden="true">↗</span></a>
      </header>
      <HomeResearch />
    </div>
  </section>

  <section class="home-lab" aria-labelledby="lab-title">
    <div class="wrap">
      <div class="lab-grid" data-reveal>
        <div class="lab-copy">
          <p class="kicker">研究平台 · 脑机接口</p>
          <h2 id="lab-title">金牛湖脑机实验室</h2>
          <p class="lab-slogan">{labSlogan.line}<span lang="en">{labSlogan.en}</span></p>
          <p>作为课题组的脑机接口研究与实验平台，金牛湖脑机实验室连接脑电信号分析、运动意图解码与智能控制。</p>
          <dl class="figures lab-figures">
            <div>
              <dt>期刊论文</dt>
              <dd class="tnum"><PublicationCount type="journal" client:load /></dd>
            </div>
            {labFigures.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd class="tnum"><span data-count={f.value}>{f.value}</span>{f.suffix}</dd>
              </div>
            ))}
          </dl>
          <div class="lab-actions">
            <a class="btn" href="/research/brain-computer-interface">走进实验室 <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="hero-science" aria-label="脑机接口实验影像">
          <div class="science-film">
            <video
              muted
              loop
              playsinline
              preload="metadata"
              poster="/videos/promo-hero-poster-v1.webp"
              data-hero-video
              aria-label="脑机实验室研究展示"
            >
              <source src="/videos/promo-hero-v1.mp4" type="video/mp4" />
            </video>
            <img class="film-poster" src="/videos/promo-hero-poster-v1.webp" alt="" aria-hidden="true" loading="lazy" />
            <button class="film-pause" type="button" aria-label="暂停实验视频" aria-pressed="false" data-video-toggle>
              <span aria-hidden="true">Ⅱ</span>
            </button>
            <span class="film-status" data-video-status role="status" hidden>实验视频暂不可用，已保留静态影像</span>
          </div>
          <figcaption class="hero-film-credit">
            <span>实验影像 · 金牛湖脑机实验室</span>
            <span class="film-progress" aria-hidden="true"><i data-film-progress></i></span>
          </figcaption>
        </figure>
      </div>

      <div class="lab-topics-head">
        <h3>五个实验专题</h3>
        <p>{labSlogan.researchIntro}</p>
      </div>
      <ol class="device-rail">
        {research.map((r, i) => (
          <li style={`--i:${i}`} data-reveal>
            <a href={`/research/${r.slug}`}>
              <span class="device-img">
                <img src={`/images/research/${r.slug}-diagram.webp`} alt={`${r.title}实验装置示意`} width="620" height="420" loading="lazy" />
              </span>
              <span class="device-meta">
                <span class="tnum">{r.num}</span>
                <strong>{r.title}</strong>
                <small>{r.subtitle}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-advisor sheet" aria-labelledby="advisor-title">
    <div class="advisor-grid">
      <div class="advisor-copy" data-reveal>
        <p class="kicker">课题组负责人</p>
        <h2 id="advisor-title">严颖 <span class="en" lang="en">Ying Yan</span></h2>
        <p class="advisor-role">{advisor.role} · {advisor.affiliation}</p>
        <p>{advisor.biography}</p>
        <ul class="tag-list" aria-label="研究兴趣">
          {advisor.interests.slice(0, 6).map((t) => <li>{t}</li>)}
        </ul>
        <a class="link" href="/about">导师介绍与学术经历 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <div class="advisor-honors" data-reveal>
        <h3>学术荣誉</h3>
        <GroupHonors />
      </div>
    </div>
  </section>

  <section class="home-evidence band-mist" id="achievements" aria-labelledby="evidence-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <div>
          <p class="kicker">科研现场</p>
          <h2 id="evidence-title">实验与学术交流</h2>
          <p class="section-desc">实验现场、临床合作、学术会议与获奖证书影像。</p>
        </div>
        <a class="link" href="/achievements#gallery">全部成果图录 <span class="arrow" aria-hidden="true">↗</span></a>
      </header>
    </div>
    <div class="image-wall" data-image-wall aria-hidden="true">
      {[wallA, wallB].map((row, r) => (
        <div class:list={["wall-row", { reverse: r === 1 }]}>
          <div class="wall-track">
            {row.map((img) => (
              <img src={img.src.replace("/images/achievements/", "/images/achievements/wall/")} alt="" loading="lazy" decoding="async" height="200" />
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="wrap wall-controls">
      <button type="button" class="wall-toggle" data-wall-toggle aria-pressed="false">暂停图片滚动</button>
    </div>
  </section>

  <section class="home-papers" id="papers" aria-labelledby="papers-title">
    <div class="wrap papers-grid">
      <header data-reveal>
        <p class="kicker">代表论文</p>
        <h2 id="papers-title">近期代表作</h2>
        <p>完整目录由论文服务实时提供，可按研究者、方向和关键词筛选。</p>
        <a class="link" href="/achievements#papers">完整论文目录 <span class="arrow" aria-hidden="true">↗</span></a>
      </header>
      <ol class="paper-editorial-list">
        {representativePapers.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={p.link} target="_blank" rel="noopener noreferrer">
              <span class="paper-index tnum">0{i + 1}</span>
              <span class="paper-body">
                <span class="paper-venue">{(p as any).isNew && <b class="paper-new">最新</b>}{p.venue} · {p.year}</span>
                <strong>{p.title}</strong>
                <span class="paper-direction">{p.direction}</span>
              </span>
              <span class="paper-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-team sheet" id="team" aria-labelledby="team-title">
    <div class="team-grid">
      <div class="team-story" data-reveal>
        <p class="kicker">团队</p>
        <h2 id="team-title">在交叉研究中共同成长</h2>
        <p>导师与研究生构成研究主力，本科生按研究方向参与课题、竞赛与毕设，在真实问题中训练成长。</p>
        <a class="link" href="/team">认识课题组与实验室协作团队 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <ul class="team-contact-sheet">
        {members.slice(0, 6).map((m, i) => (
          <li style={`--i:${i}`} data-reveal>
            <a href="/team">
              <span class="portrait"><img src={m.photo} alt={m.name} width="180" height="225" loading="lazy" /></span>
              <strong>{m.name}</strong>
              <small>{m.stage}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-join band-mist" id="admission" aria-labelledby="join-title">
    <div class="wrap join-grid" data-reveal>
      <div>
        <p class="kicker">招生 · 硕士生 5–7 人 / 年</p>
        <h2 id="join-title">欢迎加入严颖课题组</h2>
        <div class="join-actions">
          <a class="btn btn-signal" href="/join">招生与加入 <span class="arrow" aria-hidden="true">→</span></a>
          <a class="link" href={`mailto:${advisor.email}`}>{advisor.email}</a>
        </div>
      </div>
      <figure class="advisor-quote">
        <blockquote><p>{advisorQuote.text}</p></blockquote>
        <figcaption>{advisorQuote.label} —— {advisorQuote.cite}</figcaption>
      </figure>
    </div>
  </section>
</GroupLayout>

<script>
  // Image wall (from the lab site's scrolling gallery): runs only on screen,
  // pauses on hover/focus, and can be paused by the visitor (WCAG 2.2.2).
  const wall = document.querySelector<HTMLElement>("[data-image-wall]");
  const wallToggle = document.querySelector<HTMLButtonElement>("[data-wall-toggle]");
  if (wall && wallToggle) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const sync = () => {
      wallToggle.hidden = reduce.matches;
      const paused = wallToggle.getAttribute("aria-pressed") === "true";
      wallToggle.textContent = paused ? "继续图片滚动" : "暂停图片滚动";
      wall.classList.toggle("is-paused", paused);
    };
    wallToggle.addEventListener("click", () => {
      wallToggle.setAttribute("aria-pressed", String(wallToggle.getAttribute("aria-pressed") !== "true"));
      sync();
    });
    reduce.addEventListener("change", sync);
    sync();
    // A second copy makes the loop seamless; only added when motion is allowed,
    // so the static page holds each picture once.
    if (!reduce.matches) {
      wall.querySelectorAll<HTMLElement>(".wall-track").forEach((track) => {
        [...track.children].forEach((img) => track.appendChild(img.cloneNode(true)));
      });
      wall.classList.add("is-looping");
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => wall.classList.toggle("is-live", entry.isIntersecting)).observe(wall);
    }
  }

  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  const progress = document.querySelector<HTMLElement>("[data-film-progress]");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (video && toggle) {
    const update = () => {
      if (toggle.disabled) return;
      toggle.setAttribute("aria-label", video.paused ? "播放实验视频" : "暂停实验视频");
      toggle.setAttribute("aria-pressed", String(video.paused));
      toggle.innerHTML = video.paused ? '<span aria-hidden="true">▶</span>' : '<span aria-hidden="true">Ⅱ</span>';
    };
    video.addEventListener("playing", () => video.closest(".science-film")?.classList.add("film-live"));
    video.addEventListener("timeupdate", () => {
      if (progress && video.duration) progress.style.transform = `scaleX(${video.currentTime / video.duration})`;
    });
    const fail = () => {
      video.closest(".science-film")?.classList.remove("film-live");
      toggle.disabled = true;
      toggle.setAttribute("aria-label", "实验视频暂不可用");
      const status = document.querySelector<HTMLElement>("[data-video-status]");
      if (status) status.hidden = false;
      video.poster = "/videos/promo-hero-poster-v1.webp";
    };
    video.addEventListener("error", fail);
    video.querySelectorAll("source").forEach((source) => source.addEventListener("error", fail));
    if (video.error || video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) fail();
    let userPaused = false;
    const respectMotion = () => {
      if (motion.matches) video.pause();
      update();
    };
    video.addEventListener("play", update);
    video.addEventListener("pause", update);
    toggle.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        video.play().catch(() => {
          if (video.error || video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) fail();
          else update();
        });
      } else {
        userPaused = true;
        video.pause();
      }
    });
    motion.addEventListener("change", respectMotion);
    respectMotion();
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          video.pause();
        } else if (!motion.matches && !userPaused && !toggle.disabled) {
          video.play().catch(update);
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(video);
  }
</script>
