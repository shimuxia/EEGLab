---
import GroupLayout from "../layouts/GroupLayout.astro";
import HomeResearch from "../components/HomeResearch.astro";
import GroupHonors from "../components/GroupHonors.astro";
import { advisor, directions, members, representativePapers } from "../data/group";
const media = [
  {
    src: "/images/achievements/demo-lab-setup.webp",
    label: "闭环脑机接口实验现场",
    tag: "实验现场 / BCI SYSTEM",
  },
  {
    src: "/images/achievements/award-phm-hangzhou-bestpaper-ceremony.webp",
    label: "IEEE PHM 最佳论文颁奖现场",
    tag: "学术交流 / IEEE PHM",
  },
  {
    src: "/images/achievements/device-eeg-cap.webp",
    label: "脑电信号采集设备",
    tag: "实验设备 / EEG",
  },
];
---

<GroupLayout
  title="严颖课题组"
  description="南京信息工程大学严颖课题组：以模式识别与机器学习，探索复杂系统诊断、脑机接口与智能预测。"
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">南京信息工程大学 · 自动化学院</p>
        <h1 id="home-title">严颖课题组</h1>
        <p class="hero-name" lang="en">Yan Ying Research Group</p>
        <p class="hero-statement">从设备故障诊断到脑电信号解码，我们研究如何从复杂数据中辨识系统的状态，预测它的变化。</p>
        <div class="hero-actions">
          <a class="pill-link" href="#research">探索研究方向 <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/about">关于课题组 ↗</a>
        </div>
      </div>
      <a class="feature-plate" href="/research/arm">
        <span class="plate-label">研究选读 <span lang="en">/ RESEARCH FOCUS</span></span>
        <img src="/images/research/arm-diagram.webp" alt="脑电采集设备与机械臂的系统构成示意" width="900" height="600" fetchpriority="high" />
        <span class="plate-caption"><span><small>脑机接口</small><strong>脑控机械臂</strong></span><span aria-hidden="true">↗</span></span>
      </a>
    </div>
    <nav class="hero-bottom" aria-label="研究方向索引">
      <h2>研究方向</h2>
      <div>{directions.map(r => <a href={`/research#${r.id}`}>{r.title}</a>)}</div>
    </nav>
  </section>

  <section class="home-intro home-wrap" id="about" data-reveal>
    <div class="section-index">
      <span>RESEARCH PROFILE</span>

    </div>
    <div class="intro-body">
      <h2>从复杂系统中<br /><span>识别规律</span></h2>
      <div>
        <p>
          我们立足模式识别与机器学习，在复杂系统诊断、脑电分析、时序预测和优化决策之间，寻找方法与应用的连接。
        </p>

        <a class="text-link" href="/about">
          了解严颖课题组 <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-research" id="research">
    <div class="home-wrap">
      <div class="section-index">
        <span>RESEARCH FIELDS</span>

      </div>
      <div class="section-heading" data-reveal>
        <h2>七个研究方向</h2>
        <a class="text-link" href="/research">
          全部研究方向 <span>↗</span>
        </a>
      </div>
      <HomeResearch />
    </div>
  </section>

  <section class="home-lab home-wrap" data-reveal>
    <div class="lab-copy">
      <p class="eyebrow">BRAIN-COMPUTER INTERFACE</p>
      <h2>脑机接口<br /><span>实验平台</span></h2>
      <p>
        作为课题组的脑机接口研究与实验平台，金牛湖脑机实验室连接脑电信号分析、运动意图解码与智能控制。
      </p>
      <div class="lab-topics">
        <a href="/research/diagnosis">
          脑疾病诊断 <span>↗</span>
        </a>
        <a href="/research/arm">
          脑控机械臂 <span>↗</span>
        </a>
        <a href="/research/drone">
          脑控无人机 <span>↗</span>
        </a>
        <a href="/research/hand">
          脑控灵巧手 <span>↗</span>
        </a>
        <a href="/research/glove">
          脑控气动手套 <span>↗</span>
        </a>
      </div>
      <a class="pill-link" href="/research/brain-computer-interface">
        走进实验室 <span>↗</span>
      </a>
    </div>
    <figure class="hero-science" aria-label="脑机接口实验影像">
        <div class="science-film">
          <video
            muted
            loop
            playsinline
            preload="metadata"
            poster="/videos/promo-hero-poster-v1.webp"
            data-hero-video
            aria-label="脑机实验室研究展示"
          >
            <source src="/videos/promo-hero-v1.mp4" type="video/mp4" />
          </video>

          <div class="film-label" lang="en">LAB FILM</div>
          <button
            class="film-pause"
            type="button"
            aria-label="暂停实验视频"
            aria-pressed="false"
            data-video-toggle
          >
            <span aria-hidden="true">Ⅱ</span>
          </button>
          <span class="film-status" data-video-status role="status" hidden>
            实验视频暂不可用，已保留静态影像
          </span>
        </div>
        <figcaption class="hero-film-credit">
          <span>实验影像 <i aria-hidden="true"></i> 金牛湖脑机实验室</span>
          <a href="/research/brain-computer-interface">查看研究</a>
        </figcaption>
      </figure>
  </section>

  <section class="home-advisor" data-reveal>
    <div class="home-wrap advisor-editorial">
      <div class="advisor-portrait">
        <img
          src={advisor.photo}
          alt="严颖老师肖像"
          width="440"
          height="520"
          loading="lazy"
        />

      </div>
      <div class="advisor-editorial-copy">
        <p class="eyebrow">PRINCIPAL INVESTIGATOR</p>
        <h2>
          严颖<span>Ying Yan</span>
        </h2>
        <p class="advisor-role">
          {advisor.role}
          <br />
          {advisor.affiliation}
        </p>
        <div class="advisor-rule"></div>
        <p>{advisor.biography}</p>
        <div class="advisor-interests">
          {advisor.interests.slice(0, 6).map((t) => (
            <span>{t}</span>
          ))}
        </div>
        <a class="text-link" href="/about">
          导师介绍与学术经历 <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-evidence home-wrap" id="achievements">
    <div class="section-index">
      <span>RESEARCH ARCHIVE</span>

    </div>
    <div class="section-heading" data-reveal>
      <h2>实验与学术交流</h2>
      <a class="text-link" href="/achievements">
        科研成果与影像 <span>↗</span>
      </a>
    </div>
    <div class="evidence-gallery">
      {media.map((m, i) => (
        <a
          class:list={["evidence-item", { "evidence-item-wide": i === 0 }]}
          href="/achievements#gallery"
          data-reveal
        >
          <div>
            <img
              src={m.src}
              alt={m.label}
              width="900"
              height="600"
              loading="lazy"
            />
            <span class="image-arrow">↗</span>
          </div>
          <p class="eyebrow">{m.tag}</p>
          <h3>{m.label}</h3>
        </a>
      ))}
    </div>
    <div class="home-honors" data-reveal>
      <div>
        <p class="eyebrow">ACADEMIC RECOGNITION</p>
        <h3>学术荣誉</h3>
      </div>
      <GroupHonors />
    </div>
  </section>

  <section class="home-papers" id="papers">
    <div class="home-wrap">
      <div class="section-index">
        <span>SELECTED PUBLICATIONS</span>
        <a href="/achievements#papers">完整论文目录 ↗</a>
      </div>
      <h2 class="catalog-title">代表论文</h2>
      <div class="paper-editorial-list">
        {representativePapers.map((p, i) => (
          <a
            href={p.link}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
          >
            <span class="paper-index">0{i + 1}</span>
            <div>
              <p class="eyebrow">
                {p.venue} <span> / {p.year}</span>
              </p>
              <h3>{p.title}</h3>
              <span class="paper-direction">{p.direction}</span>
            </div>
            <span class="paper-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-team home-wrap" id="team" data-reveal>
    <div class="team-story">
      <p class="eyebrow">PEOPLE</p>
      <h2>课题组成员</h2>
      <p>
        了解团队成员的研究方向，以及参与脑机接口项目的临床合作者与学术顾问。
      </p>
      <a class="text-link" href="/team">
        认识课题组与实验室协作团队 <span>↗</span>
      </a>
    </div>
    <div class="team-contact-sheet">
      {members.slice(0, 6).map((m, i) => (
        <a href="/team" class:list={[{ "portrait-offset": i % 3 === 1 }]}>
          <img
            src={m.photo}
            alt={m.name}
            width="180"
            height="220"
            loading="lazy"
          />
          <span>
            {m.name}
            <small>{m.stage}</small>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-join" id="admission">
    <div class="home-wrap">
      <p class="eyebrow">
        ADMISSIONS
      </p>
      <h2>加入课题组</h2>
      <div class="join-bottom">
        <p>
          欢迎有科研热情与动手能力的你，
          <br />
          一起面对真实问题，寻找新的答案。
        </p>
        <a class="pill-link" href="/join">
          招生与加入 <span>↗</span>
        </a>
      </div>
      <div id="contact" class="join-contact">
        <a href={`mailto:${advisor.email}`}>{advisor.email} ↗</a>
        <span>南京信息工程大学 · 自动化学院</span>
      </div>
    </div>

  </section>
</GroupLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-video-toggle]",
  );
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (video && toggle) {
    const update = () => {
      if (toggle.disabled) return;
      toggle.setAttribute(
        "aria-label",
        video.paused ? "播放实验视频" : "暂停实验视频",
      );
      toggle.setAttribute("aria-pressed", String(video.paused));
      toggle.innerHTML = video.paused
        ? '<span aria-hidden="true">▷</span>'
        : '<span aria-hidden="true">Ⅱ</span>';
    };
    const fail = () => {
      toggle.disabled = true;
      toggle.setAttribute("aria-label", "实验视频暂不可用");
      const status = document.querySelector<HTMLElement>("[data-video-status]");
      if (status) status.hidden = false;
      video.poster = "/videos/promo-hero-poster-v1.webp";
    };
    video.addEventListener("error", fail);
    video
      .querySelectorAll("source")
      .forEach((source) => source.addEventListener("error", fail));
    if (
      video.error ||
      video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
    )
      fail();
    let userPaused = false;
    const respectMotion = () => {
      if (motion.matches) video.pause();
      update();
    };
    video.addEventListener("play", update);
    video.addEventListener("pause", update);
    toggle.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        video.play().catch(() => {
          if (
            video.error ||
            video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
          )
            fail();
          else update();
        });
      } else {
        userPaused = true;
        video.pause();
      }
    });
    motion.addEventListener("change", respectMotion);
    respectMotion();
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          video.pause();
        } else if (!motion.matches && !userPaused && !toggle.disabled) {
          video.play().catch(update);
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(video);
  }
</script>
