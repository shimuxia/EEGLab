---
import GroupLayout from "../layouts/GroupLayout.astro";
import Advisor from "../components/Advisor.astro";
import GroupResearch from "../components/GroupResearch.astro";
import GroupMembers from "../components/GroupMembers.astro";
import GroupHonors from "../components/GroupHonors.astro";
import { representativePapers } from "../data/group";
import Admission from "../components/Admission.astro";
---

<GroupLayout
  title="严颖课题组"
  description="南京信息工程大学自动化学院严颖课题组，探索模式识别、机器学习、复杂系统诊断与预测及脑机接口。"
>
  <section class="group-hero">
    <div>
      <p class="group-kicker">NUIST / YAN YING RESEARCH GROUP</p>
      <h1>严颖课题组</h1>
      <p>
        从复杂数据中理解系统，
        <br />
        让智能方法走向真实应用。
      </p>
      <div class="group-actions">
        <a href="/research">探索研究方向 →</a>
        <a href="/join">加入我们 →</a>
      </div>
    </div>
    <svg viewBox="0 0 600 400" aria-hidden="true">
      <path d="M0 200 Q60 200 90 160 T170 230 T250 120 T330 250 T420 180 T600 200" />
      <path d="M0 260 Q100 80 200 260 T400 260 T600 260" />
    </svg>
  </section>
  <section class="group-section" id="about">
    <Advisor />
    <div class="group-actions">
      <a href="/about">了解导师与课题组 →</a>
    </div>
  </section>
  <section class="group-section" id="research">
    <p class="group-kicker">RESEARCH</p>
    <h2>面向真实问题的交叉研究</h2>
    <GroupResearch />
  </section>
  <section class="group-section" id="team">
    <h2>团队与成长</h2>
    <GroupMembers compact />
    <div class="group-actions">
      <a href="/team">课题组成员与实验室协作团队 →</a>
    </div>
  </section>
  <section class="group-section" id="achievements">
    <h2>学术荣誉</h2>
    <GroupHonors />
    <div id="papers" class="group-subsection">
      <h2>代表论文</h2>
      <div class="group-grid">
        {representativePapers.map((p) => (
          <article class="group-card">
            <h3>{p.title}</h3>
            <p>
              {p.year} · {p.venue}
            </p>
            <a href={p.link} target="_blank" rel="noopener noreferrer">
              Google Scholar ↗
            </a>
          </article>
        ))}
      </div>
      <div class="group-actions">
        <a href="/achievements#papers">完整论文目录与筛选 →</a>
      </div>
    </div>
  </section>
  <section class="group-section" id="admission">
    <h2>欢迎加入严颖课题组</h2>
    <Admission />
  </section>
  <section class="group-section" id="contact">
    <h2>联系与交流</h2>
    <a href="/contact">邮箱、办公地点与学术主页 →</a>
  </section>
</GroupLayout>
