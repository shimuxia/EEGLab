---
import GroupLayout from "../layouts/GroupLayout.astro";
import ResearchArtwork from "../components/ResearchArtwork.astro";
import HomeResearch from "../components/HomeResearch.astro";
import GroupHonors from "../components/GroupHonors.astro";
import { advisor, members, representativePapers } from "../data/group";
import "../styles/home.css";
---

<GroupLayout
  title="严颖课题组"
  description="南京信息工程大学严颖课题组：模式识别、机器学习、复杂系统诊断与预测、脑机接口及优化决策。"
>
  <div class="home-root">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <p class="hero-affiliation">南京信息工程大学 · 自动化学院</p>
        <h1 id="home-title">严颖课题组</h1>
        <p class="hero-english">Yan Ying Research Group</p>
        <p class="hero-statement">让智能方法，走向真实世界。</p>
        <p class="hero-description">
          以<span class="keep-word">模式识别</span>与
          <span class="keep-word">机器学习</span>，探索
          <span class="keep-word">复杂系统诊断</span>、
          <br class="desktop-break" />
          <span class="keep-word">脑机接口</span>、
          <span class="keep-word">智能预测</span>与
          <span class="keep-word">优化决策</span>。
        </p>
        <div class="hero-actions">
          <a class="pill-link" href="#research">
            探索研究方向
          </a>
          <a class="hero-secondary" href="/about">
            了解课题组 <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-spectrum" aria-label="部分研究方向">
          <a href="/research#research-fault-diagnosis">
            <ResearchArtwork index={0} />
            <span>复杂系统诊断</span>
          </a>
          <a href="/research/brain-computer-interface">
            <ResearchArtwork index={1} />
            <span>脑机接口</span>
          </a>
          <a href="/research#research-power-load-rainfall">
            <ResearchArtwork index={2} />
            <span>智能预测</span>
          </a>
          <a href="/research#research-optimization">
            <ResearchArtwork index={4} />
            <span>优化决策</span>
          </a>
        </div>
        <div class="hero-bottom">
          <span>从方法创新，到真实应用。</span>
          <a href="#research">
            探索全部七个方向 <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-intro home-wrap" id="about" data-reveal>
      <p class="home-section-label">我们的研究</p>
      <h2>
        理解复杂系统。
        <br />
        <span>回应真实问题。</span>
      </h2>
      <p class="intro-description">
        从理论建模到工程实现，我们以模式识别和机器学习为基础，
        <br class="desktop-break" />
        在不同学科与应用场景之间，寻找清晰、可靠的方法。
      </p>
    </section>

    <section class="home-research" id="research">
      <div class="home-wrap">
        <div class="home-section-heading" data-reveal>
          <div>
            <p class="home-section-label">Research</p>
            <h2>七个方向，持续探索。</h2>
          </div>
          <a class="text-link" href="/research">
            全部研究方向 <span aria-hidden="true">›</span>
          </a>
        </div>
        <HomeResearch />
      </div>
    </section>

    <section class="home-lab home-wrap" data-reveal>
      <div class="lab-copy">
        <p class="home-section-label">脑机接口研究方向</p>
        <h2>
          让思想，
          <br />
          驱动未来。
        </h2>
        <p>
          金牛湖脑机实验室是课题组的脑机接口研究与实验平台。我们连接脑电信号分析、运动意图解码与智能控制，探索从算法到系统的完整链路。
        </p>
        <a class="text-link" href="/research/brain-computer-interface">
          了解实验室 <span aria-hidden="true">›</span>
        </a>
      </div>
      <div class="lab-media">
        <div class="science-film">
          <video
            muted
            loop
            playsinline
            preload="metadata"
            poster="/videos/promo-hero-poster-v1.webp"
            data-hero-video
            aria-label="金牛湖脑机实验室研究影像"
          >
            <source src="/videos/promo-hero-v1.mp4" type="video/mp4" />
          </video>
          <button
            class="film-pause"
            type="button"
            aria-label="暂停实验视频"
            aria-pressed="false"
            data-video-toggle
          >
            <span aria-hidden="true">Ⅱ</span>
          </button>
          <span class="film-status" data-video-status role="status" hidden>
            实验视频暂不可用，已保留静态影像
          </span>
        </div>
        <p class="lab-media-caption">金牛湖脑机实验室 · 研究展示视频</p>
      </div>
      <div class="lab-topics">
        <a href="/research/diagnosis">
          脑疾病诊断 <span aria-hidden="true">›</span>
        </a>
        <a href="/research/arm">
          脑控机械臂 <span aria-hidden="true">›</span>
        </a>
        <a href="/research/drone">
          脑控无人机 <span aria-hidden="true">›</span>
        </a>
        <a href="/research/hand">
          脑控灵巧手 <span aria-hidden="true">›</span>
        </a>
        <a href="/research/glove">
          脑控气动手套 <span aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <section class="home-advisor" data-reveal>
      <div class="home-wrap advisor-editorial">
        <div class="advisor-portrait">
          <img
            src={advisor.photo}
            alt="严颖老师肖像"
            width="440"
            height="520"
            loading="lazy"
          />
        </div>
        <div class="advisor-editorial-copy">
          <p class="home-section-label">课题组负责人</p>
          <h2>
            严颖<span>Ying Yan</span>
          </h2>
          <p class="advisor-role">
            {advisor.role}
            <br />
            {advisor.affiliation}
          </p>
          <p class="advisor-biography">{advisor.biography}</p>
          <a class="text-link" href="/about">
            导师介绍与学术经历 <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-evidence home-wrap" id="achievements">
      <div class="home-section-heading" data-reveal>
        <div>
          <p class="home-section-label">科研成果</p>
          <h2>
            扎实的研究。
            <br />
            <span>可见的进展。</span>
          </h2>
        </div>
        <a class="text-link" href="/achievements">
          查看科研成果 <span aria-hidden="true">›</span>
        </a>
      </div>
      <div class="evidence-gallery">
        <a class="evidence-item" href="/achievements#awards" data-reveal>
          <img
            src="/images/achievements/award-phm-hangzhou-bestpaper-ceremony.webp"
            alt="2023年IEEE PHM最佳论文奖颁奖现场"
            width="900"
            height="600"
            loading="lazy"
          />
          <p>学术交流</p>
          <h3>2023 IEEE PHM Best Paper Award</h3>
        </a>
        <a class="evidence-item" href="/achievements#gallery" data-reveal>
          <img
            src="/images/achievements/device-eeg-cap.webp"
            alt="实验室柔性干电极脑电帽"
            width="900"
            height="600"
            loading="lazy"
          />
          <p>实验平台</p>
          <h3>连接算法与应用的研究设备</h3>
        </a>
      </div>
      <div class="home-honors" data-reveal>
        <div>
          <p class="home-section-label">Academic recognition</p>
          <h2>学术荣誉</h2>
        </div>
        <GroupHonors />
      </div>
    </section>

    <section class="home-papers" id="papers">
      <div class="home-wrap">
        <div class="home-section-heading" data-reveal>
          <div>
            <p class="home-section-label">Selected publications</p>
            <h2>代表论文</h2>
          </div>
          <a class="text-link" href="/achievements#papers">
            完整论文目录 <span aria-hidden="true">›</span>
          </a>
        </div>
        <div class="paper-editorial-list">
          {representativePapers.map((p, i) => (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              data-reveal
            >
              <span class="paper-index">0{i + 1}</span>
              <div>
                <p class="paper-venue">
                  {p.venue} · {p.year}
                </p>
                <h3>{p.title}</h3>
                <span class="paper-direction">{p.direction}</span>
              </div>
              <span class="paper-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-team home-wrap" id="team" data-reveal>
      <div class="team-story">
        <p class="home-section-label">团队成员</p>
        <h2>
          与好奇的人，
          <br />
          一起探索。
        </h2>
        <p>
          不同的背景，共同的求知欲。
          <br />
          在讨论、实践与协作中，让想法成为现实。
        </p>
        <a class="text-link" href="/team">
          认识我们的团队 <span aria-hidden="true">›</span>
        </a>
      </div>
      <div class="team-contact-sheet">
        {members.slice(0, 6).map((m) => (
          <a href="/team">
            <img
              src={m.photo}
              alt={m.name}
              width="180"
              height="220"
              loading="lazy"
            />
            <span>
              {m.name}
              <small>{m.stage}</small>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-join" id="admission">
      <div class="home-wrap" data-reveal>
        <p class="home-section-label">Join us</p>
        <h2>
          下一次探索，
          <br />
          期待与你一起。
        </h2>
        <p>
          欢迎有科研热情、扎实基础和动手能力的同学，
          <br class="desktop-break" />
          加入交叉学科研究与工程实践。
        </p>
        <a class="pill-link" href="/join">
          招生与加入
        </a>
        <div id="contact" class="join-contact">
          <a href={`mailto:${advisor.email}`}>{advisor.email}</a>
          <span>南京信息工程大学 · 自动化学院</span>
        </div>
      </div>
    </section>
  </div>
</GroupLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-video-toggle]",
  );
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (video && toggle) {
    const update = () => {
      if (toggle.disabled) return;
      toggle.setAttribute(
        "aria-label",
        video.paused ? "播放实验视频" : "暂停实验视频",
      );
      toggle.setAttribute("aria-pressed", String(video.paused));
      toggle.innerHTML = video.paused
        ? '<span aria-hidden="true">▷</span>'
        : '<span aria-hidden="true">Ⅱ</span>';
    };
    const fail = () => {
      toggle.disabled = true;
      toggle.setAttribute("aria-label", "实验视频暂不可用");
      const status = document.querySelector<HTMLElement>("[data-video-status]");
      if (status) status.hidden = false;
      video.poster = "/videos/promo-hero-poster-v1.webp";
    };
    video.addEventListener("error", fail);
    video
      .querySelectorAll("source")
      .forEach((source) => source.addEventListener("error", fail));
    if (
      video.error ||
      video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
    )
      fail();
    const respectMotion = () => {
      if (motion.matches) video.pause();
      update();
    };
    video.addEventListener("play", update);
    video.addEventListener("pause", update);
    toggle.addEventListener("click", () => {
      if (video.paused)
        video.play().catch(() => {
          if (
            video.error ||
            video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
          )
            fail();
          else update();
        });
      else video.pause();
    });
    motion.addEventListener("change", respectMotion);
    respectMotion();
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) video.pause();
      },
      { threshold: 0.05 },
    );
    observer.observe(video);
  }
</script>
