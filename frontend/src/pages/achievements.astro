---
import GroupHonors from '../components/GroupHonors.astro';
import { representativePapers } from '../data/group';
import { projectPatentNote } from '../data/source-extras';
import GroupLayout from '../layouts/GroupLayout.astro';
import GalleryFilter from '../components/GalleryFilter.astro';
import PublicationCount from '../components/PublicationCount';
import PublicationsExplorer from '../components/PublicationsExplorer';
import awardsData from '../data/awards.toml';
import galleryData from '../data/gallery.toml';

type Award = {
  year: number;
  name: string;
  description: string;
  teamMentors?: string[];
  teamAwardees?: string[];
  image?: string;
  images?: string[];
};
const awards = ((awardsData as any).awards as Award[]).map((award) => ({
  ...award,
  images: award.images ?? (award.image ? [award.image] : []),
}));
const galleryGrid = (galleryData as any).grid as { src: string; label: string; tag: string }[];
---

<GroupLayout
  title="科研成果"
  description="严颖副教授团队在脑机接口、EEG信号分析、模式识别等领域的学术成果汇总"
>
  <header class="page-mast archive-mast">
    <div class="wrap">
      <div>
        <p class="kicker">严颖课题组</p>
        <h1 class="ph-title">科研成果<span class="en" lang="en">Publications · Awards · Archive</span></h1>
        <p class="masthead-lead ph-sub">严颖副教授团队在脑机接口、EEG 信号分析、模式识别等领域的学术成果汇总。</p>
      </div>
      <div class="stats-row">
        <div class="stat-item">
          <div class="stat-num"><PublicationCount client:load /></div>
          <div class="stat-label">收录论文</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{awards.length}</div>
          <div class="stat-label">代表奖项</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{galleryGrid.length}</div>
          <div class="stat-label">成果图录</div>
        </div>
      </div>
    </div>
  </header>

  <div class="wrap ach-body">
    <aside class="ach-sidebar" id="ach-sidebar">
      <nav aria-label="成果章节">
        <p class="sidebar-label">本页目录</p>
        <ul class="sidebar-nav" id="sidebar-nav">
          <li><a href="#papers" class="active">期刊与会议论文 <span class="nav-count"><PublicationCount client:load /></span></a></li>
          <li><a href="#awards">荣誉奖项 <span class="nav-count">{awards.length}</span></a></li>
          <li><a href="#gallery">成果展示 <span class="nav-count">{galleryGrid.length}</span></a></li>
        </ul>
      </nav>
    </aside>

    <div class="ach-main">
      <section id="papers" class="ach-section" aria-labelledby="papers-heading">
        <div class="section-header">
          <h2 class="section-heading" id="papers-heading">期刊与会议论文</h2>
        </div>
        <PublicationsExplorer client:load />
        <noscript>
          <h3>课题组选登的代表论文</h3>
          <p>浏览实时目录和使用筛选需要启用 JavaScript。</p>
          <ul class="static-selection">{representativePapers.map(p => <li><small>{p.year} · {p.venue}</small><a href={p.link}>{p.title}</a></li>)}</ul>
          <style is:inline>.publication-loading {display:none}</style>
        </noscript>
      </section>

      <section id="awards" class="ach-section" aria-labelledby="awards-heading">
        <div class="section-header">
          <h2 class="section-heading" id="awards-heading">荣誉奖项</h2>
        </div>
        <div class="mentor-honors"><h3>导师学术荣誉</h3><GroupHonors /><p class="project-note"><b>{projectPatentNote.kind}</b>{projectPatentNote.title}：{projectPatentNote.meta}</p></div>
        <div class="award-timeline">
          {awards.map((award, i) => (
            <div class="award-row">
              <div class="award-left">
                <div class="award-dot"></div>
                {i < awards.length - 1 && <div class="award-line"></div>}
                <span class="award-year">{award.year}</span>
              </div>
              <div class="award-body">
                <div class="award-name">{award.name}</div>
                <div class="award-desc">{award.description}</div>
                {(award.teamMentors?.length || award.teamAwardees?.length) && (
                  <div class="award-people">
                    {award.teamMentors?.length > 0 && (
                      <div class="award-people-row">
                        <span>团队指导老师</span>
                        <strong>{award.teamMentors.join('、')}</strong>
                      </div>
                    )}
                    {award.teamAwardees?.length > 0 && (
                      <div class="award-people-row">
                        <span>团队获奖成员</span>
                        <strong>{award.teamAwardees.join('、')}</strong>
                      </div>
                    )}
                  </div>
                )}
                {award.images.length > 0 && (
                  <div class="award-images">
                    {award.images.map((image) => (
                      <div class="award-img">
                        <img src={image} alt={award.name} loading="lazy" />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="gallery" class="ach-section" aria-labelledby="gallery-heading">
        <div class="section-header">
          <h2 class="section-heading" id="gallery-heading">成果展示</h2>
          <span class="section-note">按类别筛选</span>
        </div>
        <GalleryFilter items={galleryGrid} />
      </section>
    </div>
  </div>
</GroupLayout>

<script>
  const sections = document.querySelectorAll('.ach-section');
  const navLinks = document.querySelectorAll('#sidebar-nav a');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(a => { a.classList.remove('active'); a.removeAttribute('aria-current'); });
        const link = document.querySelector(`#sidebar-nav a[href="#${entry.target.id}"]`);
        link?.classList.add('active');
        link?.setAttribute('aria-current', 'location');
      }
    });
  }, { rootMargin: '-30% 0px -55% 0px' });
  sections.forEach(s => io.observe(s));
</script>
