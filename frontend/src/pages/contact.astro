---
import GroupLayout from "../layouts/GroupLayout.astro";
import { advisor } from "../data/group";
import { labDomain } from "../data/source-extras";
---

<GroupLayout title="联系与交流">
  <header class="correspondence">
    <div class="wrap correspondence-grid">
      <div>
        <p class="kicker">严颖课题组</p>
        <h1>联系与交流<span class="en" lang="en">Contact</span></h1>
        <p>欢迎围绕课题研究、招生及产学研合作与我们交流。</p>
      </div>
      <div class="address-block">
        <span>电子邮箱</span>
        <a href={`mailto:${advisor.email}`}>{advisor.email}<span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>
  <section class="group-section" id="contact-details" aria-label="联系方式">
    <div class="wrap">
      <div class="contact-columns">
        <article class="contact-card">
          <span class="tnum">01</span>
          <h2>办公地点</h2>
          <p>{advisor.office}<br />{advisor.affiliation}</p>
        </article>
        <article class="contact-card">
          <span class="tnum">02</span>
          <h2>学术主页</h2>
          <p><a href={advisor.homepage}>NUIST 官方个人主页 ↗</a></p>
          <p><a href={advisor.scholar}>Google Scholar ↗</a></p>
        </article>
        <article class="contact-card">
          <span class="tnum">03</span>
          <h2>实验平台</h2>
          <p>金牛湖产教融合园区 · 金牛湖脑机实验室</p>
          <p><a href="/research/brain-computer-interface">脑机接口研究与实验室 →</a></p>
          <p><a href={labDomain.href} target="_blank" rel="noopener">{labDomain.label} ↗</a></p>
        </article>
      </div>
      <div class="page-actions">
        <a class="btn btn-ghost" href="/join">查看招生信息 <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</GroupLayout>
