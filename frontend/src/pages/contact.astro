---
import GroupLayout from "../layouts/GroupLayout.astro";
import { advisor } from "../data/group";
---

<GroupLayout title="联系与交流">
  <header class="group-header">
    <p class="group-kicker">CONTACT</p>
    <h1>联系与交流</h1>
    <p>欢迎围绕课题研究、招生及产学研合作与我们交流。</p>
  </header>
  <section class="group-section">
    <div class="group-grid">
      <article class="group-card">
        <h2>电子邮箱</h2>
        <a href={`mailto:${advisor.email}`}>{advisor.email}</a>
      </article>
      <article class="group-card">
        <h2>办公地点</h2>
        <p>
          {advisor.office}
          <br />
          {advisor.affiliation}
        </p>
      </article>
      <article class="group-card">
        <h2>学术主页</h2>
        <p>
          <a href={advisor.homepage}>NUIST 官方个人主页 ↗</a>
        </p>
        <a href={advisor.scholar}>Google Scholar ↗</a>
      </article>
      <article class="group-card">
        <h2>实验平台</h2>
        <p>金牛湖产教融合园区 · 金牛湖脑机实验室</p>
        <a href="/research/brain-computer-interface">脑机接口研究与实验室 →</a>
      </article>
    </div>
    <div class="group-actions">
      <a href="/join">查看招生信息 →</a>
    </div>
  </section>
</GroupLayout>
