---
import SectionHeader from "../components/SectionHeader.astro";
import GroupLayout from "../layouts/GroupLayout.astro";
import { advisor } from "../data/group";
---

<GroupLayout title="联系与交流">
  <SectionHeader title="联系与交流" english="CONTACT" links={[{"href": "#contact-details", "label": "联系方式"}, {"href": "/join", "label": "招生信息"}]}>
    欢迎围绕课题研究、招生及产学研合作与我们交流。
  </SectionHeader>
  <section class="group-section" id="contact-details">
    <div class="group-grid contact-directory">
      <article class="group-card contact-mail">
        <h2>电子邮箱</h2>
        <a href={`mailto:${advisor.email}`}>{advisor.email}</a>
      </article>
      <article class="group-card">
        <h2>办公地点</h2>
        <p>
          {advisor.office}
          <br />
          {advisor.affiliation}
        </p>
      </article>
      <article class="group-card">
        <h2>学术主页</h2>
        <p>
          <a href={advisor.homepage}>NUIST 官方个人主页 ↗</a>
        </p>
        <a href={advisor.scholar}>Google Scholar ↗</a>
      </article>
      <article class="group-card">
        <h2>实验平台</h2>
        <p>金牛湖产教融合园区 · 金牛湖脑机实验室</p>
        <a href="/research/brain-computer-interface">脑机接口研究与实验室 →</a>
      </article>
    </div>
    <div class="group-actions">
      <a href="/join">查看招生信息 →</a>
    </div>
  </section>
</GroupLayout>
