---
import GroupLayout from "../layouts/GroupLayout.astro";
import Admission from "../components/Admission.astro";
---

<GroupLayout title="招生与加入">
  <div class="group-section admissions-spread">
    <header>
      <p class="group-kicker" lang="en">Admissions</p>
      <h1>招生与加入</h1>
      <p>欢迎有科研热情、扎实基础和动手能力的同学，参与交叉学科研究与实际应用。</p>
      <a class="text-link" href="/contact">联系导师 ↗</a>
    </header>
    <section id="admission-info"><h2>招生信息</h2><Admission /></section>
  </div>
</GroupLayout>
