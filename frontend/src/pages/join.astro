---
import GroupLayout from "../layouts/GroupLayout.astro";
import Admission from "../components/Admission.astro";
import { admissionLead, advisorQuote, labJoin } from "../data/source-extras";
---

<GroupLayout title="招生与加入">
  <div class="wrap admissions-spread">
    <header>
      <p class="kicker">招生</p>
      <h1>招生与加入<span class="en" lang="en">Admissions</span></h1>
      <p>欢迎有科研热情、扎实基础和动手能力的同学，参与交叉学科研究与实际应用。</p>
      <figure class="advisor-quote join-quote">
        <blockquote><p>{advisorQuote.text}</p></blockquote>
        <figcaption>{advisorQuote.label} —— {advisorQuote.cite}</figcaption>
      </figure>
      <div class="admissions-actions">
        <a class="btn" href="/contact">联系导师 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link" href="/research">先了解研究方向 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </header>
    <section id="admission-info" aria-labelledby="admission-title">
      <h2 id="admission-title" class="sr-only">招生信息</h2>
      <p class="admission-lead">{admissionLead}</p>
      <Admission />
      <section class="lab-join" aria-labelledby="lab-join-title">
        <p class="kicker">金牛湖脑机实验室</p>
        <h3 id="lab-join-title">加入脑机实验室</h3>
        <p>{labJoin.detail}</p>
        <h4>申请要求</h4>
        <ul>{labJoin.requirements.map((r) => <li>{r}</li>)}</ul>
      </section>
    </section>
  </div>
</GroupLayout>
