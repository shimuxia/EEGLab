---
import GroupLayout from "../layouts/GroupLayout.astro";
import Admission from "../components/Admission.astro";
---

<GroupLayout title="招生与加入">
  <header class="group-header">
    <p class="group-kicker">JOIN US</p>
    <h1>保持好奇，一起探索。</h1>
    <p>
      欢迎有科研热情、扎实基础和动手能力的同学，参与交叉学科研究与实际应用。
    </p>
  </header>
  <section class="group-section">
    <h2>招生信息</h2>
    <Admission />
  </section>
</GroupLayout>
