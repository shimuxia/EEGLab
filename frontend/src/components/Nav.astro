---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/about", label: "关于我们", en: "About" },
  { href: "/research", label: "研究方向", en: "Research" },
  { href: "/team", label: "团队成员", en: "People" },
  { href: "/achievements", label: "科研成果", en: "Publications" },
  { href: "/join", label: "招生与加入", en: "Join us" },
  { href: "/contact", label: "联系交流", en: "Contact" },
];
---

<a class="skip-link" href="#main-content">
  跳转至正文
</a>
<nav id="navbar" aria-label="主导航">
  <a class="nav-brand" href="/" aria-label="严颖课题组首页">
    <svg
      viewBox="0 0 40 40"
      width="36"
      height="36"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x=".5"
        y=".5"
        width="39"
        height="39"
        rx="10"
        stroke="currentColor"
        opacity=".35"
      />
      <path
        d="M7 21H12L15 14L20 28L24 12L28 21H33"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span class="nav-brand-copy">
      <strong>严颖课题组</strong>
      <small>YAN YING RESEARCH GROUP</small>
    </span>
  </a>
  <div class="nav-right">
    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={
              path === link.href || path.startsWith(link.href + "/")
                ? "page"
                : undefined
            }
            class:list={[{ "nav-contact": link.href === "/contact" }]}
          >
            <span>{link.label}</span>
            <small>{link.en}</small>
            {link.href === "/contact" && <b aria-hidden="true">↗</b>}
          </a>
        </li>
      ))}
    </ul>
    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</nav>
<script>
  const navbar = document.getElementById("navbar")!;
  const toggle = document.getElementById("nav-toggle")!;
  const links = document.getElementById("nav-links")!;
  const setOpen = (open: boolean) => {
    links.classList.toggle("open", open);
    toggle.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  };
  toggle.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  links
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle.getAttribute("aria-expanded") === "true"
    ) {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (!navbar.contains(event.target as Node)) setOpen(false);
  });
  const scrolled = () =>
    navbar.classList.toggle("scrolled", window.scrollY > 30);
  window.addEventListener("scroll", scrolled, { passive: true });
  scrolled();
</script>
<style>
  .skip-link {
    position: fixed;
    left: 15px;
    top: 0;
    transform: translateY(-150%);
    background: var(--accent);
    color: #ffffff;
    padding: 12px;
    z-index: 300;
    text-decoration: none;
  }
  .skip-link:focus {
    transform: translateY(0);
    top: 12px;
  }
  #navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    min-height: 64px;
    height: auto;
    padding: 10px 6vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: #fafaf7ee;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(20px);
    transition: box-shadow 0.3s;
  }
  #navbar.scrolled {
    box-shadow: 0 10px 35px #26302408;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    color: var(--accent);
    text-decoration: none;
  }
  .nav-brand-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nav-brand-copy strong {
    font-size: 17px;
    line-height: 1.2;
    color: var(--text);
    font-weight: 500;
    letter-spacing: 1px;
  }
  .nav-brand-copy small {
    font: 7px var(--font-mono);
    letter-spacing: 1.25px;
    color: var(--text-3);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
  }
  .nav-links a {
    font-size: 12px;
    text-decoration: none;
    color: var(--text-2);
    transition: color 0.25s;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--accent);
  }
  .nav-links a > small {
    display: none;
  }
  .nav-links .nav-contact {
    border: 1px solid var(--border-md);
    border-radius: 24px;
    padding: 12px 19px;
    color: var(--text);
  }
  .nav-contact b {
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: var(--accent);
  }
  .nav-toggle {
    display: none;
    width: 35px;
    height: 35px;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
  }
  .nav-toggle > span {
    position: absolute;
    height: 1px;
    background: var(--accent);
    width: 24px;
    left: 5px;
    transition:
      transform 0.3s,
      top 0.3s;
    top: 13px;
  }
  .nav-toggle > span:last-child {
    top: 21px;
    width: 18px;
  }
  .nav-toggle.open > span:first-child {
    transform: rotate(45deg);
    top: 17px;
  }
  .nav-toggle.open > span:last-child {
    transform: rotate(-45deg);
    top: 17px;
    width: 24px;
  }
  @media (max-width: 1100px) {
    .nav-toggle {
      display: block;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fafaf7fa;
      border-bottom: 1px solid var(--border);
      padding: 22px 6vw 30px;
      gap: 0;
      align-items: stretch;
      flex-direction: column;
      backdrop-filter: blur(24px);
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      font-size: 17px;
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
    }
    .nav-links a > small {
      display: block;
      margin-left: auto;
      font: 10px var(--font-mono);
      color: var(--text-3);
    }
    .nav-links .nav-contact {
      border: 0;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      padding: 17px 0;
    }
    .nav-contact b {
      display: none;
    }
  }
  @media (max-width: 600px) {
    #navbar {
      min-height: 64px;
      padding-block: 10px;
      padding-inline: 7vw;
    }
    .nav-brand-copy strong {
      font-size: 15px;
    }
    .nav-brand-copy small {
      font-size: 6px;
      letter-spacing: 1px;
    }
    .nav-brand svg {
      width: 32px;
      height: 32px;
    }
    .nav-links {
      top: 100%;
    }
  }
</style>
