---
import { directions } from "../data/group";
import ResearchArtwork from "./ResearchArtwork.astro";
import { researchTaglines } from "../data/source-extras";
---

<div class="research-workbench" data-research-workbench>
  <div
    class="research-selector"
    role="tablist"
    aria-label="探索七个研究方向"
    aria-orientation="vertical"
  >
    {directions.map((r, i) => (
      <button
        id={`research-tab-${i}`}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`research-panel-${i}`}
        tabindex={i === 0 ? 0 : -1}
        data-research-tab={i}
      >
        <span class="tab-no tnum">{r.no}</span>
        <strong>{r.title}</strong>
        <span class="research-tab-arrow" aria-hidden="true">→</span>
      </button>
    ))}
  </div>
  <div class="research-panels">
    {directions.map((r, i) => (
      <article
        class="research-panel"
        id={`research-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`research-tab-${i}`}
        hidden={i !== 0}
        tabindex="0"
      >
        <div class="research-panel-top">
          <span lang="en">{r.en}</span>
          <span class="tnum">{r.no} / 07</span>
        </div>
        <ResearchArtwork index={i} />
        <div class="research-panel-copy">
          <p class="panel-tagline">{researchTaglines[i]}</p>
          <h3>{r.title}</h3>
          <p>{r.desc}</p>
          <ul class="tag-list research-panel-tags">
            {r.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <a
            class="link"
            href={
              i === 1
                ? "/research/brain-computer-interface"
                : `/research#${r.id}`
            }
          >
            {i === 1 ? "进入脑机实验室" : "探索这一方向"} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-research-workbench]")
    .forEach((root) => {
      const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
      const mobile = window.matchMedia("(max-width: 600px)");
      const orientation = () =>
        list.setAttribute(
          "aria-orientation",
          mobile.matches ? "horizontal" : "vertical",
        );
      orientation();
      mobile.addEventListener("change", orientation);
      const tabs = [
        ...root.querySelectorAll<HTMLButtonElement>("[data-research-tab]"),
      ];
      const panels = [
        ...root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
      ];
      const activate = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute("aria-selected", String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
        });
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
        });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowDown" || event.key === "ArrowRight")
            next = (index + 1) % tabs.length;
          else if (event.key === "ArrowUp" || event.key === "ArrowLeft")
            next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(next, true);
        });
      });
    });
</script>
