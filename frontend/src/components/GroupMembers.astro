---
import { members, studentGroups } from "../data/group";
const { compact = false } = Astro.props;
---

<div data-member-directory>
  {!compact && (
    <div class="member-switch segmented" role="group" hidden aria-label="筛选课题组成员">
      <button type="button" data-show="all" aria-pressed="true">全部</button>
      <button type="button" data-show="graduates" aria-pressed="false">研究生与校友</button>
      <button type="button" data-show="projects" aria-pressed="false">本科项目成员与校友</button>
    </div>
  )}
  <section class="member-group" data-member-group="graduates">
    <h3>研究生与校友 <span class="tnum">{members.length}</span></h3>
    <ul class="people-grid">
      {members.map((m) => (
        <li class="person">
          {m.photo && (
            <span class="portrait">
              <img src={m.photo} alt={m.photoAlt ?? m.name} width="180" height="225" loading="lazy" />
            </span>
          )}
          <h4>{m.name}</h4>
          <p>{m.stage}</p>
          {m.note && <p>{m.note}</p>}
        </li>
      ))}
    </ul>
  </section>
  {!compact &&
    studentGroups.map((g) => (
      <section class="member-group group-subsection" data-member-group="projects">
        <h3>{g.dir} · 本科生 / 项目参与与校友 <span class="tnum">{g.students.length}</span></h3>
        <ul class="people-grid">
          {g.students.map((m) => (
            <li class="person">
              {m.photo && (
                <span class="portrait">
                  <img src={m.photo} alt={m.name} width="180" height="225" loading="lazy" />
                </span>
              )}
              <h4>{m.name}</h4>
              <p>{m.stage}</p>
              {m.note && <p>{m.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-member-directory]").forEach((directory) => {
    const controls = directory.querySelector<HTMLElement>(".member-switch");
    if (!controls) return;
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll("button")];
    const groups = [...directory.querySelectorAll<HTMLElement>("[data-member-group]")];
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let order = 0;
        for (const group of groups) {
          group.hidden = button.dataset.show !== "all" && group.dataset.memberGroup !== button.dataset.show;
          if (!group.hidden && !reduce) {
            group.querySelectorAll<HTMLElement>(".person").forEach((person) => {
              person.animate(
                [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }],
                { duration: 420, delay: Math.min(order++, 12) * 30, easing: "cubic-bezier(.16,1,.3,1)", fill: "backwards" },
              );
            });
          }
        }
      }),
    );
  });
</script>
