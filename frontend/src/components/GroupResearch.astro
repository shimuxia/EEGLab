---
import { directions } from "../data/group";
import SignalTrace from "./SignalTrace.astro";
---

<div class="research-overview">
  {directions.map((r, i) => (
    <article class:list={["field", { "field-feature": i === 1 }]} id={r.id}>
      <header class="field-head">
        <span class="field-number tnum" aria-hidden="true">{r.no}</span>
        <div>
          <h3>{r.title}</h3>
          <p class="field-en" lang="en">{r.en}</p>
        </div>
      </header>
      <div class="field-body">
        <p>{r.desc}</p>
        <ul class="tag-list" aria-label="关键词">
          {r.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {i === 1 && (
          <a class="link" href="/research/brain-computer-interface">
            金牛湖脑机实验室 · 研究与平台 <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      {i === 1 ? (
        <a class="field-photo" href="/research/brain-computer-interface" aria-label="进入脑机接口研究平台">
          <img src="/images/achievements/demo-eeg-monitor.webp" alt="实验人员在监视器上观察脑电信号" loading="lazy" width="660" height="440" />
        </a>
      ) : (
        <div class="field-trace">
          <SignalTrace index={i} grid />
        </div>
      )}
    </article>
  ))}
</div>
