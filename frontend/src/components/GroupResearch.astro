---
import { directions } from "../data/group";
import ResearchArtwork from "./ResearchArtwork.astro";
---

<div class="research-overview">
  {directions.map((r, i) => (
    <article class:list={["group-card", {"field-feature": i === 1}]} id={r.id}>
      <div>
        <span class="field-number" aria-hidden="true">{r.no}</span>
        <span class="group-kicker">
          {r.en}
        </span>
        <h3>{r.title}</h3>
        <p>{r.desc}</p>
        <div class="group-tags">
          {r.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
        {i === 1 && (
          <a class="text-link" href="/research/brain-computer-interface">
            金牛湖脑机实验室 · 研究与平台 <span>↗</span>
          </a>
        )}
      </div>
      {i === 1
        ? <a class="field-photo" href="/research/brain-computer-interface" aria-label="进入脑机接口研究平台"><img src="/images/achievements/demo-eeg-monitor.webp" alt="实验人员在监视器上观察脑电信号" loading="lazy" width="660" height="440" /></a>
        : <ResearchArtwork index={i} />}
    </article>
  ))}
</div>
