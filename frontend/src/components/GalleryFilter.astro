---
interface GalleryItem {
  src: string;
  label: string;
  tag: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

const galleryTags = Array.from(new Set(items.map(i => i.tag)));
---

<div id="gallery-filter-root">
  <div class="gf-filter-bar">
    {galleryTags.map(tag => (
      <button class="gf-chip" aria-pressed="false" data-tag={tag}>{tag}</button>
    ))}
    <button class="gf-chip active" aria-pressed="true" data-tag="全部">全部</button>
  </div>

  <div class="gf-grid">
    {items.map(item => (
      <div class="gf-item" data-tag={item.tag}>
        <img src={item.src} alt={item.label} class="gf-img" loading="lazy" />
        <div class="gf-caption">
          <span class="gf-tag">{item.tag}</span>
          <span class="gf-label">{item.label}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="gf-no-results" style="display:none">该分类下暂无内容</div>
</div>

<script>
  const root = document.getElementById('gallery-filter-root')!;
  const chips = root.querySelectorAll<HTMLButtonElement>('.gf-chip');
  const items = root.querySelectorAll<HTMLElement>('.gf-item');
  const noResults = root.querySelector<HTMLElement>('.gf-no-results')!;

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.getAttribute('data-tag')!;
      chips.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
      chip.setAttribute('aria-pressed', 'true');
      chip.classList.add('active');

      let any = false;
      let position = 0;
      items.forEach(item => {
        const show = tag === '全部' || item.getAttribute('data-tag') === tag;
        item.style.display = show ? '' : 'none';
        if (show) {
          any = true;
          if (position < 9 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            item.getAnimations().forEach(animation => animation.cancel());
            item.animate(
              [{ opacity: 0.45, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }],
              { duration: 330, delay: position * 24, easing: "ease-out", fill: "backwards" }
            );
          }
          position++;
        }
      });
      noResults.style.display = any ? 'none' : '';
    });
  });
</script>

<style>
  #gallery-filter-root .gf-filter-bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 1.75rem;
    background: var(--bg-surface);
    border-radius: 3px;
  }
  #gallery-filter-root .gf-chip {
    min-height: 36px;
    padding: 0.3rem 0.9rem;
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  #gallery-filter-root .gf-chip:hover {
    color: var(--text);
  }
  #gallery-filter-root .gf-chip.active {
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--border), 0 1px 2px rgb(22 24 27 / 0.08);
  }
  #gallery-filter-root .gf-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem) clamp(0.75rem, 1.5vw, 1.25rem);
  }
  #gallery-filter-root .gf-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  #gallery-filter-root .gf-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    object-position: center;
    display: block;
    background: var(--bg-surface);
    transition: transform 600ms var(--ease-out);
  }
  #gallery-filter-root .gf-caption {
    display: grid;
    gap: 0.1rem;
  }
  #gallery-filter-root .gf-tag {
    font-size: 0.75rem;
    color: var(--text-3);
  }
  #gallery-filter-root .gf-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text);
    line-height: 1.45;
  }
  #gallery-filter-root .gf-no-results {
    color: var(--text-3);
    font-size: var(--fs-sm);
    padding: 2.5rem 0;
  }
  @media (max-width: 900px) {
    #gallery-filter-root .gf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
