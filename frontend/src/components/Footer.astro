---
import { advisor } from "../data/group";
const icpNumber = import.meta.env.PUBLIC_ICP_NUMBER?.trim() || "苏ICP备2026027101号-2";
const sitemap = [
  ["/about", "关于我们"],
  ["/research", "研究方向"],
  ["/research/brain-computer-interface", "脑机实验室"],
  ["/team", "团队成员"],
  ["/achievements", "科研成果"],
  ["/join", "招生与加入"],
  ["/contact", "联系交流"],
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-id">
      <a class="footer-brand" href="/">严颖课题组</a>
      <p>南京信息工程大学自动化学院。以模式识别与机器学习研究复杂系统诊断、时序预测与脑机接口。</p>
    </div>
    <nav class="footer-nav" aria-label="站点导航">
      <h2>站点</h2>
      <ul>{sitemap.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
    <div class="footer-contact">
      <h2>联系</h2>
      <a href={`mailto:${advisor.email}`}>{advisor.email}</a>
      <p>{advisor.office}</p>
      <p>金牛湖产教融合园区 · 金牛湖脑机实验室</p>
    </div>
    <div class="footer-unis">
      <h2>依托单位</h2>
      <div>
        <a href="https://www.nuist.edu.cn" target="_blank" rel="noopener noreferrer">
          <img src="/images/nuist-logo.webp" alt="南京信息工程大学" class="footer-uni-logo nuist" width="180" height="44" loading="lazy" />
        </a>
        <a href="https://www.ahjzu.edu.cn" target="_blank" rel="noopener noreferrer">
          <img src="/images/ahjzu-logo.webp" alt="安徽建筑大学" class="footer-uni-logo ahjzu" width="150" height="35" loading="lazy" />
        </a>
      </div>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>&copy; 2026 Yan Ying Research Group · NUIST</p>
    {icpNumber && <p><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{icpNumber}</a></p>}
    <div
      class="footer-stats"
      data-analytics-summary
      data-state="loading"
      aria-live="polite"
      title="隐私友好统计：不使用 Cookie，不保存原始 IP"
    >
      <span class="footer-stat"><strong data-stat="totalViews">—</strong>累计浏览</span>
      <span class="footer-stat"><strong data-stat="todayViews">—</strong>今日访问</span>
      <span class="footer-stat"><strong data-stat="todayVisitors">—</strong>今日访客</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    padding-top: clamp(48px, 6vw, 88px);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 40px clamp(24px, 4vw, 64px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .footer-brand {
    display: inline-block;
    font: 700 1.5rem/1.2 var(--font-display);
    letter-spacing: 0.06em;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .footer-id p {
    max-width: 24em;
    line-height: 1.75;
  }
  .site-footer h2 {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-3);
    margin-bottom: 0.9rem;
  }
  .footer-nav ul {
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .site-footer a {
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .site-footer a:hover {
    color: var(--accent);
  }
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .footer-contact a {
    font-weight: 600;
  }
  .footer-unis > div {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .footer-uni-logo {
    width: auto;
    max-width: 100%;
  }
  .footer-uni-logo.nuist {
    height: 40px;
  }
  .footer-uni-logo.ahjzu {
    height: 32px;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .footer-base a {
    color: var(--text-3);
  }
  .footer-stats {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    transition: opacity 0.2s ease;
  }
  .footer-stats[data-state="loading"] {
    opacity: 0.55;
  }
  .footer-stats[data-state="error"] {
    display: none;
  }
  .footer-stat strong {
    color: var(--text-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-right: 4px;
  }
  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-id {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .footer-stats {
      margin-left: 0;
    }
  }
</style>

<script>
  type AnalyticsSummary = {
    totalViews: number;
    todayViews: number;
    todayVisitors: number;
    trackingSince: string;
  };

  const root = document.querySelector<HTMLElement>('[data-analytics-summary]');
  const analyticsWindow = window as Window & {
    __eeglabAnalyticsReady?: Promise<boolean>;
  };

  const loadSummary = async () => {
    if (!root || import.meta.env.PUBLIC_ENABLE_ANALYTICS !== 'true') { if (root) root.dataset.state = 'error'; return; }
    try {
      await (analyticsWindow.__eeglabAnalyticsReady ?? Promise.resolve(false));
      const response = await fetch('/api/analytics/summary', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error(`Analytics summary failed: ${response.status}`);
      const summary = await response.json() as AnalyticsSummary;
      const numberFormat = new Intl.NumberFormat('zh-CN');
      for (const key of ['totalViews', 'todayViews', 'todayVisitors'] as const) {
        const target = root.querySelector<HTMLElement>(`[data-stat="${key}"]`);
        if (target) target.textContent = numberFormat.format(summary[key]);
      }
      root.title = `自 ${summary.trackingSince} 起统计 · 不使用 Cookie · 不保存原始 IP`;
      root.dataset.state = 'ready';
    } catch {
      root.dataset.state = 'error';
    }
  };

  void loadSummary();
</script>
