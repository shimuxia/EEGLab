---
interface Props { slug: string; title: string; }
const { slug, title } = Astro.props;
const views = [
  { src: `/images/research/${slug}-diagram.webp`, label: "实验装置" },
  { src: `/images/research/${slug}.webp`, label: "原理示意" },
];
---
<figure class="device-plate">
  <div class="device-views">
    {views.map((v, i) => (
      <img
        src={v.src}
        alt={`${title} · ${v.label}`}
        aria-hidden={i !== 0 ? "true" : "false"}
        class:list={[{ current: i === 0 }]}
        loading={i === 0 ? "eager" : "lazy"}
        width="620"
        height="560"
      />
    ))}
  </div>
  <figcaption>
    <span>{title}</span>
    <div class="plate-switch" role="group" hidden aria-label="选择研究图版">
      {views.map((v, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"}>{v.label}</button>)}
    </div>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>(".device-plate").forEach((plate) => {
    const controls = plate.querySelector<HTMLElement>(".plate-switch")!;
    const images = [...plate.querySelectorAll<HTMLImageElement>("img")];
    const buttons = [...controls.querySelectorAll("button")];
    controls.hidden = false;
    buttons.forEach((b, index) =>
      b.addEventListener("click", () => {
        buttons.forEach((button, i) => {
          button.setAttribute("aria-pressed", String(i === index));
          images[i].classList.toggle("current", i === index);
          images[i].setAttribute("aria-hidden", String(i !== index));
        });
      }),
    );
  });
</script>
<style>
  .device-plate {
    margin: 0;
    min-width: 0;
  }
  .device-views {
    position: relative;
    aspect-ratio: 1.35;
    background: #fff;
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .device-views img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    opacity: 0;
  }
  .device-views img.current {
    opacity: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.85rem;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .plate-switch {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.2rem;
    background: var(--bg-surface);
    border-radius: 3px;
  }
  .plate-switch[hidden] {
    display: none;
  }
  button {
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--text-2);
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  button[aria-pressed="true"] {
    background: #fff;
    color: var(--text);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--border);
  }
  @media (prefers-reduced-motion: no-preference) {
    img {
      transition:
        opacity 380ms var(--ease-std),
        transform 600ms var(--ease-out);
      transform: scale(0.97);
    }
    img.current {
      transform: none;
    }
  }
</style>
