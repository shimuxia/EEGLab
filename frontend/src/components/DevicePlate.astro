---
interface Props { slug: string; title: string; }
const { slug, title } = Astro.props;
const views = [
  { src: `/images/research/${slug}.webp`, label: "研究示意" },
  { src: `/images/research/${slug}-diagram.webp`, label: "系统图解" },
];
---
<figure class="device-plate">
  <div class="device-views">
    {views.map((v,i) => <img src={v.src} alt={`${title} · ${v.label}`} aria-hidden={i !== 0} class:list={[{ current:i === 0 }]} loading={i === 0 ? "eager" : "lazy"} width="620" height="560" />)}
  </div>
  <figcaption>
    <span>{title}</span>
    <div class="plate-switch" hidden aria-label="选择研究图版">
      {views.map((v,i) => <button aria-pressed={i === 0 ? "true" : "false"}>{v.label}</button>)}
    </div>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>(".device-plate").forEach(plate => {
    const controls = plate.querySelector<HTMLElement>(".plate-switch")!;
    const images = [...plate.querySelectorAll<HTMLImageElement>("img")];
    const buttons = [...controls.querySelectorAll("button")];
    controls.hidden = false;
    buttons.forEach((b, index) => b.addEventListener("click", () => {
      buttons.forEach((button, i) => {
        button.setAttribute("aria-pressed", String(i === index));
        images[i].classList.toggle("current", i === index);
        images[i].setAttribute("aria-hidden", String(i !== index));
      });
    }));
  });
</script>
<style>
 .device-plate {margin:0;min-width:0;}
 .device-views {position:relative;aspect-ratio:1.13;background:var(--bg-surface);overflow:hidden;}
 .device-views img {position:absolute;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;opacity:0;}
 .device-views img.current {opacity:1;}
 figcaption {display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.55rem;padding:.65rem 0;border-bottom:1px solid var(--border-md);font-size:.8rem;color:var(--text-2);}
 .plate-switch {display:flex;}
 .plate-switch[hidden] {display:none;}
 button {background:transparent;border:1px solid var(--border-md);color:var(--text);cursor:pointer;padding:.5em .7em;}
 button[aria-pressed=true] {background:var(--bg-dark);color:white;}
 @media(prefers-reduced-motion:no-preference){
   img {transition:opacity 380ms ease,transform 480ms ease;transform:translateX(12px);}
   img.current {transform:none;}
 }
</style>
