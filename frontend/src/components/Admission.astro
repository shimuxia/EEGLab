---
import { admission, advisor } from "../data/group";
---

<div class="group-grid">
  {admission.map((item) => (
    <article class="group-card">
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </article>
  ))}
</div>
<p class="group-subsection">
  具体名额及报考安排以学校当年招生通知为准。欢迎通过{" "}
  <a href={`mailto:${advisor.email}`}>{advisor.email}</a>{" "}
  介绍你的研究兴趣与实践经历。
</p>
