---
import { admission, advisor } from "../data/group";
const split = (title: string) => {
  const [zh, en] = title.split(" / ");
  return { zh, en };
};
---

<ol class="admission-list">
  {admission.map((item, i) => {
    const t = split(item.title);
    return (
      <li class="admission-item" data-reveal style={`--i:${i}`}>
        <span class="admission-no tnum">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <h3>{t.zh}{t.en && <span class="en" lang="en">{t.en}</span>}</h3>
          <p>{item.text}</p>
        </div>
      </li>
    );
  })}
</ol>
<aside class="admission-contact">
  <h3>联系导师</h3>
  <p>
    具体名额及报考安排以学校当年招生通知为准。欢迎通过{" "}
    <a href={`mailto:${advisor.email}`}>{advisor.email}</a>{" "}
    介绍你的研究兴趣与实践经历。
  </p>
</aside>
